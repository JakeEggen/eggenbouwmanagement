<div id="cookie-banner" class="cookie-banner" role="dialog" aria-labelledby="cookie-banner-title" hidden>
  <h2 id="cookie-banner-title" class="cookie-banner__title">Statistieken</h2>
  <p class="cookie-banner__text">
    Wij gebruiken Google Analytics om te zien welke pagina's worden bezocht.
    Dat doen we alleen met uw toestemming.
    Meer hierover staat in de <%= link_to "privacyverklaring", privacy_path %>.
  </p>
  <div class="cookie-banner__actions">
    <button type="button" class="btn btn-primary" data-cookie-accept>Accepteren</button>
    <button type="button" class="btn btn-outline-secondary" data-cookie-decline>Weigeren</button>
  </div>
</div>
